{
  "name": "stepiajs",
  "version": "0.1.0-alpha1",
  "type": "module",
  "description": "Build your tests step-by-step",
  "bin": {
    "stepia": "bin/stepia.js"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "pre:check": "prettier --check \"**/*.{js,jsx,cjs,mjs,ts,tsx}\"",
    "pre:write": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TestLungo/stepiajs.git"
  },
  "keywords": [
    "test"
  ],
  "author": "Ivan Boyko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TestLungo/stepiajs/issues"
  },
  "homepage": "https://github.com/TestLungo/stepiajs#readme",
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
