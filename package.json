{
  "name": "@stepia/monorepo",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Build your tests step-by-step",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:release": "npm run clean && npm run build",
    "clean": "rimraf packages/*/{dist,tsconfig.tsbuildinfo}",
    "pre:check": "prettier --check \"**/*.{js,jsx,cjs,mjs,ts,tsx}\"",
    "pre:write": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TestLungo/stepiajs.git"
  },
  "keywords": [
    "test"
  ],
  "author": "Ivan Boyko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TestLungo/stepiajs/issues"
  },
  "homepage": "https://github.com/TestLungo/stepiajs#readme",
  "devDependencies": {
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
