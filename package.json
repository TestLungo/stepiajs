{
  "name": "@stepia/monorepo",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Build your tests step-by-step",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:release": "npm run clean && npm run build",
    "clean": "rimraf packages/*/{dist,tsconfig.tsbuildinfo}",
    "eslint:lint": "eslint \"**/*.{js,jsx,cjs,mjs,ts,tsx}\"",
    "eslint:fix": "eslint \"**/*.{js,jsx,cjs,mjs,ts,tsx}\" --fix",
    "prettier:lint": "prettier --check \"**/*.{js,jsx,cjs,mjs,ts,tsx}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx}\"",
    "prepare": "husky",
    "publish": "npm run build:release && npm publish --workspaces"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TestLungo/stepiajs.git"
  },
  "keywords": [
    "test"
  ],
  "author": "Ivan Boyko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TestLungo/stepiajs/issues"
  },
  "homepage": "https://github.com/TestLungo/stepiajs#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
